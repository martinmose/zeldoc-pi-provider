{
  "name": "zeldoc-pi-provider",
  "version": "0.1.1",
  "description": "Zeldoc.ai model provider extension for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Martin Mose Facondini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinmose/zeldoc-pi-provider.git"
  },
  "homepage": "https://github.com/martinmose/zeldoc-pi-provider#readme",
  "bugs": {
    "url": "https://github.com/martinmose/zeldoc-pi-provider/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "zeldoc",
    "zdev",
    "llm",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./extensions/zeldoc.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format": "biome check .",
    "format:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.33.0"
}
